FROM node:latest
#FROM ghcr.io/cyber-dojo-languages/javascript-node:14d6b57
LABEL maintainer=jon@jaggersoft.com
LABEL maintainer=marcoemrich77@googlemail.com

RUN apt update
RUN apt install --yes python-is-python3

RUN mkdir /etc/rescript
WORKDIR /etc/rescript
COPY . .
RUN npm install 
RUN chown -R sandbox .
